{
  "name": "archive",
  "description": "",
  "version": "0.0.0",
  "homepage": "",
  "private": true,
  "type": "module",
  "main": "src",
  "author": {
    "name": "TimIsOverpowered"
  },
  "contributors": [],
  "bugs": {},
  "directories": {
    "tests": "tests/"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "test": "node --test --import tsx --import ./tests/setup.ts --test-timeout 10000 --test-concurrency 4 --experimental-test-module-mocks \"tests/**/*.test.ts\"",
    "test:coverage": "node --test --import tsx --import ./tests/setup.ts --test-timeout 10000 --test-concurrency 4 --experimental-test-module-mocks --experimental-test-coverage \"tests/**/*.test.ts\"",
    "lint": "biome lint --write src scripts tests",
    "fix": "biome check --write src scripts tests",
    "format": "biome format --write src scripts tests",
    "build": "tsc",
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "start": "concurrently --names api,workers \"node dist/src/index.js\" \"node dist/src/workers/index.js\"",
    "all": "concurrently --names api,workers \"npm run api\" \"npm run workers\"",
    "api": "cross-env NODE_ENV=development tsx src/index.ts",
    "workers": "cross-env NODE_ENV=development tsx src/workers/index.ts",
    "auth:youtube": "tsx scripts/auth-youtube.ts",
    "auth:twitch": "tsx scripts/auth-twitch.ts",
    "migrate:streamer": "tsx scripts/migrate-streamer.ts",
    "create:tenant": "tsx scripts/create-tenant.ts",
    "import:tenant": "tsx scripts/import-tenant.ts",
    "create:admin": "tsx scripts/create-admin.ts",
    "reset:admin": "tsx scripts/reset-admin-key.ts",
    "start:pm2": "pm2 start ecosystem.config.cjs --env production && pm2 save",
    "stop:pm2": "pm2 stop all && pm2 delete all",
    "restart:pm2": "pm2 restart all",
    "logs:pm2": "pm2 logs --lines 100 --raw",
    "deps:circular": "npx madge --ts-config tsconfig.json --circular src/index.ts src/workers/index.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.2.0",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "dayjs": "^1.11.23",
    "fastify": "^5.12.1",
    "googleapis": "^176.0.0",
    "hls-parser": "^0.16.1",
    "impit": "^0.14.3",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "kysely": "^0.29.5",
    "lru-cache": "^11.5.2",
    "p-limit": "^7.3.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "rate-limiter-flexible": "^11.2.0",
    "undici": "8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "ioredis-mock": "^8.13.1",
    "knip": "^6.32.2",
    "open": "^11.0.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
